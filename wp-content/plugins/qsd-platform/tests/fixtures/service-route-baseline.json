{
    "contract": "service-route-baseline.v1",
    "routes": [
        {
            "route": "qsd/v1/admin/categories",
            "methods": "GET",
            "callback": "listCategories",
            "permission_callback": "requireAdmin",
            "args": {
                "platform_status": {
                    "enum": [
                        "archived",
                        "trashed"
                    ],
                    "required": false,
                    "type": "string"
                }
            }
        },
        {
            "route": "qsd/v1/admin/categories",
            "methods": "POST",
            "callback": "createCategory",
            "permission_callback": "requireAdmin",
            "args": {
                "description": {
                    "required": false,
                    "sanitize_callback": "sanitize_textarea_field",
                    "type": "string"
                },
                "name": {
                    "required": true,
                    "sanitize_callback": "sanitize_text_field",
                    "type": "string"
                }
            }
        },
        {
            "route": "qsd/v1/admin/categories/(?P<id>\\d+)",
            "methods": "DELETE",
            "callback": "permanentDeleteCategory",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/categories/(?P<id>\\d+)/overview",
            "methods": "PUT",
            "callback": "saveOverview",
            "permission_callback": "requireAdmin",
            "args": {
                "description": {
                    "required": false,
                    "sanitize_callback": "sanitize_textarea_field",
                    "type": "string"
                },
                "id": {
                    "required": true,
                    "type": "integer"
                },
                "name": {
                    "required": true,
                    "sanitize_callback": "sanitize_text_field",
                    "type": "string"
                }
            }
        },
        {
            "route": "qsd/v1/admin/categories/(?P<id>\\d+)/overview/revert",
            "methods": "POST",
            "callback": "revertOverview",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/categories/(?P<id>\\d+)/overview/settle",
            "methods": "POST",
            "callback": "settleOverview",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/categories/(?P<id>\\d+)/restore",
            "methods": "POST",
            "callback": "restoreCategory",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/categories/(?P<id>\\d+)/status",
            "methods": "PATCH",
            "callback": "updateStatus",
            "permission_callback": "requireAdmin",
            "args": {
                "action": {
                    "enum": [
                        "disable",
                        "enable"
                    ],
                    "required": false,
                    "type": "string"
                },
                "id": {
                    "required": true,
                    "type": "integer"
                },
                "platform_status": {
                    "enum": [
                        "active",
                        "disabled",
                        "archived",
                        "trashed"
                    ],
                    "required": false,
                    "type": "string"
                }
            }
        },
        {
            "route": "qsd/v1/admin/categories/(?P<platform_id>QSD[A-Z0-9]+)",
            "methods": "GET",
            "callback": "fetchCategoryByPlatformId",
            "permission_callback": "requireAdmin",
            "args": {
                "platform_id": {
                    "required": true,
                    "type": "string"
                }
            }
        },
        {
            "route": "qsd/v1/admin/service-categories",
            "methods": "POST",
            "callback": "createServiceCategory",
            "permission_callback": "requireAdmin",
            "args": []
        },
        {
            "route": "qsd/v1/admin/service-categories/(?P<id>\\d+)",
            "methods": "POST",
            "callback": "updateServiceCategory",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services",
            "methods": "GET",
            "callback": "listServices",
            "permission_callback": "requireAdmin",
            "args": {
                "platform_status": {
                    "enum": [
                        "archived",
                        "trashed"
                    ],
                    "required": false,
                    "type": "string"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services",
            "methods": "POST",
            "callback": "createService",
            "permission_callback": "requireAdmin",
            "args": {
                "category_ids": {
                    "items": {
                        "type": "integer"
                    },
                    "required": false,
                    "type": "array"
                },
                "content": {
                    "required": false,
                    "sanitize_callback": "wp_kses_post",
                    "type": "string"
                },
                "excerpt": {
                    "required": false,
                    "sanitize_callback": "sanitize_textarea_field",
                    "type": "string"
                },
                "title": {
                    "required": true,
                    "sanitize_callback": "sanitize_text_field",
                    "type": "string"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)",
            "methods": "DELETE",
            "callback": "permanentDeleteService",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)",
            "methods": "GET",
            "callback": "fetchDetail",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)/(?P<module>overview|inclusions|faqs|elements)/revert",
            "methods": "POST",
            "callback": "revertModule",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                },
                "module": {
                    "required": true,
                    "type": "string"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)/(?P<module>overview|inclusions|faqs|elements)/settle",
            "methods": "POST",
            "callback": "settleModuleRoute",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                },
                "module": {
                    "required": true,
                    "type": "string"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)/elements",
            "methods": "GET",
            "callback": "fetchElements",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)/elements",
            "methods": "POST",
            "callback": "updateElements",
            "permission_callback": "requireAdmin",
            "args": {
                "elements": {
                    "items": {
                        "type": "object"
                    },
                    "required": true,
                    "type": "array"
                },
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)/faq-pool/items",
            "methods": "POST",
            "callback": "createFaqPoolItem",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)/faqs",
            "methods": "POST",
            "callback": "updateFaqs",
            "permission_callback": "requireAdmin",
            "args": {
                "faqs": {
                    "items": {
                        "type": "object"
                    },
                    "required": true,
                    "type": "array"
                },
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)/inclusion-pool/items",
            "methods": "POST",
            "callback": "createInclusionPoolItem",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)/inclusions",
            "methods": "POST",
            "callback": "updateInclusions",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                },
                "inclusions": {
                    "items": {
                        "type": "object"
                    },
                    "required": true,
                    "type": "array"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)/overview",
            "methods": "POST",
            "callback": "updateOverview",
            "permission_callback": "requireAdmin",
            "args": {
                "category_ids": {
                    "items": {
                        "type": "integer"
                    },
                    "required": false,
                    "type": "array"
                },
                "content": {
                    "required": false,
                    "sanitize_callback": "wp_kses_post",
                    "type": "string"
                },
                "excerpt": {
                    "required": false,
                    "sanitize_callback": "sanitize_textarea_field",
                    "type": "string"
                },
                "id": {
                    "required": true,
                    "type": "integer"
                },
                "title": {
                    "required": true,
                    "sanitize_callback": "sanitize_text_field",
                    "type": "string"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)/restore",
            "methods": "POST",
            "callback": "restoreService",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)/settle",
            "methods": "POST",
            "callback": "settleAll",
            "permission_callback": "requireAdmin",
            "args": {
                "id": {
                    "required": true,
                    "type": "integer"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<id>\\d+)/status",
            "methods": "POST",
            "callback": "updateStatus",
            "permission_callback": "requireAdmin",
            "args": {
                "action": {
                    "enum": [
                        "disable",
                        "enable"
                    ],
                    "required": false,
                    "type": "string"
                },
                "id": {
                    "required": true,
                    "type": "integer"
                },
                "is_active": {
                    "required": false,
                    "type": "boolean"
                },
                "platform_status": {
                    "enum": [
                        "active",
                        "disabled",
                        "archived",
                        "trashed"
                    ],
                    "required": false,
                    "type": "string"
                },
                "post_status": {
                    "enum": [
                        "publish",
                        "draft"
                    ],
                    "required": false,
                    "type": "string"
                }
            }
        },
        {
            "route": "qsd/v1/admin/services/(?P<platform_id>QSD[A-Z0-9]+)",
            "methods": "GET",
            "callback": "fetchDetailByPlatformId",
            "permission_callback": "requireAdmin",
            "args": {
                "platform_id": {
                    "required": true,
                    "type": "string"
                }
            }
        }
    ]
}
