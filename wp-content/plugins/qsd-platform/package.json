{
  "name": "qsd-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Dev-only tooling for the QSD Platform Admin Station. The server never runs npm: it receives the built dist/ files.",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:php": "for t in tests/*.php; do [ \"$t\" = tests/autoload.php ] || php \"$t\" || exit 1; done",
    "test:js": "node scripts/run-all.mjs",
    "test": "npm run typecheck && npm run test:php && npm run build && npm run test:js && npm run docs:check",
    "contract:account-registration": "tsx scripts/account-registration-contract.ts",
    "contract:admin-station-css": "node scripts/admin-station-css-contract.mjs",
    "contract:api-client-timeout": "tsx scripts/api-client-timeout-contract.ts",
    "contract:category-identifier-api": "tsx scripts/category-identifier-api-contract.ts",
    "contract:child-nav-sticky": "tsx scripts/child-nav-sticky-contract.ts",
    "contract:drawer-module-entry": "tsx scripts/drawer-module-entry-contract.ts",
    "contract:platform-identity-schema": "tsx scripts/platform-identity-schema-contract.ts",
    "contract:service-catalogue-projection": "tsx scripts/service-catalogue-projection-contract.ts",
    "contract:service-home-connections": "tsx scripts/service-home-connections-contract.ts",
    "contract:settings-station": "tsx scripts/settings-station-contract.ts",
    "contract:station-tabset": "tsx scripts/station-tabset-contract.ts",
    "contract:supported-action-footer": "tsx scripts/supported-action-footer-contract.ts",
    "regression:category-create": "node scripts/category-create-regression.mjs",
    "regression:drawer-trash-confirm": "node scripts/drawer-trash-confirm-regression.mjs",
    "regression:entity-action-footer-menu-only": "node scripts/entity-action-footer-menu-only-regression.mjs",
    "regression:service-create": "node scripts/service-create-regression.mjs",
    "regression:service-create-handoff": "node scripts/service-create-handoff-regression.mjs",
    "regression:service-disable-enable": "node scripts/service-disable-enable-regression.mjs",
    "regression:service-home-bin": "node scripts/service-home-bin-regression.mjs",
    "regression:service-home-connections": "node scripts/service-home-connections-regression.mjs",
    "regression:publish-activation-guard": "node scripts/publish-activation-guard-regression.mjs",
    "regression:services-settings": "node scripts/services-settings-regression.mjs",
    "regression:service-open-save-race": "node scripts/service-open-save-race-regression.mjs",
    "snapshot:mode-renderer": "node scripts/mode-renderer-snapshot.mjs",
    "snapshot:module-state": "node scripts/module-state-snapshot.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "dev": "vite"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^25.8.0",
    "happy-dom": "^20.11.1",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.1"
  },
  "dependencies": {
    "preact": "^10.29.1"
  }
}
